Options -Indexes -MultiViews
RewriteEngine On
RewriteRule ^(?:\.user\.ini|bootstrap\.php|lib\.php|pdf\.php|projects\.json|project-drive\.php|drive-defaults\.json|composer\.(?:json|lock)|vendor(?:/|$)) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
